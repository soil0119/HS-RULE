# Copy to a private path OUTSIDE the checkout, then chmod 600 that file.
# All credentials below are placeholders and must be replaced before deployment.
POSTGRES_PASSWORD=replace-with-random-database-owner-password
DB_APP_PASSWORD=replace-with-random-app-role-password
# Percent-encode special characters in URL passwords; both URLs use Docker's db hostname.
DB_ADMIN_URL=postgresql://postgres:replace-with-url-encoded-owner-password@db:5432/hansungrules
DATABASE_URL=postgresql://hsrule_web:replace-with-url-encoded-app-password@db:5432/hansungrules
ADMIN_ID=replace-with-admin-login
ADMIN_PW=replace-with-random-admin-password
SECRET_KEY=replace-with-random-secret-at-least-32-characters
PUBLIC_ORIGIN=https://hs.officeworkkit.com
# The tunnel profile is started only AFTER the token file and public hostname route exist.
# Compose config needs an absolute path even when the tunnel profile is inactive.
HSRULE_TUNNEL_TOKEN_FILE=/srv/hsrule-private/tunnel-token
HSRULE_IMAGE_TAG=production
# Optional immutable image references; use the platform-correct digest after testing.
# HSRULE_POSTGRES_IMAGE=pgvector/pgvector:pg16@sha256:...
# HSRULE_CLOUDFLARED_IMAGE=cloudflare/cloudflared:latest@sha256:...
