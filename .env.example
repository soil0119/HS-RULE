# Copy to .env and enter your own Groq key. Never commit .env.
GROQ_API_KEY=
DATABASE_URL=postgresql://postgres:local-development-password@127.0.0.1:5432/hansungrules
POSTGRES_PASSWORD=local-development-password

ADMIN_ID=admin
ADMIN_PW=replace-with-a-strong-password
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Optional: fresh cookies from your authorized browser session, encoded as JSON.
HANSUNG_COOKIES_JSON='{}'
