# Copy to .env and configure the services you run. Keep .env out of Git.
DATABASE_URL=
# Optional. Defaults to uploads/ in the application directory.
UPLOAD_DIR=
PUBLIC_ORIGIN=https://hs.officeworkkt.com

ADMIN_ID=
ADMIN_PW=
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Optional values for the separate database, crawler and RAG workflows.
POSTGRES_PASSWORD=
HANSUNG_COOKIES_JSON='{}'
# RAG LLM provider: gemini (default) or groq.
LLM_PROVIDER=gemini
# Gemini (Google AI Studio free tier). Key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GROQ_API_KEY=
# Optional. Disposable PostgreSQL with pgvector for the official-regulation index tests (docker compose up db).
HSRULE_TEST_DATABASE_URL=
# Model id for RAG answers. Required for the RAG adapter; no default is assumed.
# Gemini example: gemini-3.5-flash (check AI Studio that the model is on the free tier).
GEMINI_MODEL=
GROQ_MODEL=
